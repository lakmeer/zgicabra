#!/bin/sh

# Manually exercises the performance-mode launch path (KMSCON exec'ing
# zgicabra directly, no login shell) from the dev desktop, without touching
# the boot specialisation. Uses vt3, not vt1 -- vt1 is owned by the X
# session in dev mode; the real boot service (sys/config.nix) uses vt1,
# since nothing else wants it there.
#
# ARGV is bin/zgicabra-launch, not the zgicabra binary directly -- kmscon
# --login wipes the exec'd child's environment (confirmed: even PATH is
# gone), so anything the real binary needs (PATH, XDG_RUNTIME_DIR,
# PIPEWIRE_RUNTIME_DIR for the audio backend) has to be rebuilt right
# before it runs, not set upstream of kmscon. See zgicabra-launch and
# AGENTS.md's "Performance-mode launch" note.

cd /home/zgicabra/zgicabra/target/release || exit 1

exec sudo kmscon --vt=3 --login \
  --font-engine=pango \
  --font-name="Terminus (TTF)" \
  --font-size=20 \
  -- /home/zgicabra/zgicabra/bin/zgicabra-launch
