#!/bin/sh

# Manually exercises the performance-mode launch path (KMSCON exec'ing
# zgicabra directly, no login shell) from the dev desktop, without touching
# the boot specialisation. Uses vt3, not vt1 -- vt1 is owned by the X
# session in dev mode; the real boot service (sys/config.nix) uses vt1,
# since nothing else wants it there.
#
# sudo + --login: kmscon needs root/CAP_SYS_TTY_CONFIG to own a VT when run
# interactively like this (matches the hand-tested ~/kms prototype), and
# --login is required for kmscon to actually run the `-- ARGV` we give it --
# without it, kmscon ignores everything after `--` and always execs its own
# hardcoded default (`/bin/login -p`).

cd /home/zgicabra/zgicabra/target/release || exit 1

exec sudo env XDG_RUNTIME_DIR="/run/user/$(id -u)" \
  kmscon --vt=3 --login \
    --font-engine=pango \
    --font-name="Terminus (TTF)" \
    --font-size=20 \
    -- /home/zgicabra/zgicabra/target/release/zgicabra
